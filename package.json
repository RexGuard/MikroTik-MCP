{
  "name": "mikrotik-mcp",
  "version": "0.1.0",
  "description": "MikroTik MCP server: let Claude and other AI assistants monitor and configure MikroTik RouterOS routers via the REST API (v7) or binary API (v6/v7)",
  "main": "dist/src/index.js",
  "scripts": {
    "build": "tsc -p .",
    "test": "npm run build && node --test dist/test/*.test.js",
    "start": "node dist/src/index.js",
    "prepare": "npm run build"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "mikrotik",
    "routeros",
    "routeros-api",
    "routeros-rest-api",
    "winbox",
    "router",
    "network-automation",
    "firewall",
    "claude",
    "claude-desktop",
    "claude-code",
    "ai",
    "llm",
    "cursor"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  },
  "type": "module",
  "bin": {
    "mikrotik-mcp": "dist/src/index.js"
  },
  "files": [
    "dist/src",
    "README.md",
    "LICENSE",
    "llms.txt"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RexGuard/MikroTik-MCP.git"
  },
  "homepage": "https://github.com/RexGuard/MikroTik-MCP#readme",
  "bugs": {
    "url": "https://github.com/RexGuard/MikroTik-MCP/issues"
  }
}
